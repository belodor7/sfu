<Window x:Class="lab_6.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:local="clr-namespace:lab_6"
 mc:Ignorable="d"
 Title="ФильмОценкаРус" Height="600" Width="900">
 <Grid Margin="8">
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="2*" />
 <ColumnDefinition Width="2*" />
 <ColumnDefinition Width="1.5*" />
 <ColumnDefinition Width="2*" />
 </Grid.ColumnDefinitions>

 <!--1: Film list -->
 <GroupBox Header="Список фильмов" Grid.Column="0" Margin="4">
 <DataGrid ItemsSource="{Binding Movies}" SelectedItem="{Binding SelectedMovie, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
 <DataGrid.Columns>
 <DataGridTextColumn Header="Название" Binding="{Binding Title}" />
 <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" />
 <DataGridTextColumn Header="Режиссер" Binding="{Binding Director.Name}" />
 <DataGridTextColumn Header="Год" Binding="{Binding Year}" />
 <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" />
 </DataGrid.Columns>
 </DataGrid>
 </GroupBox>

 <!--2: Movie details / add/remove -->
 <GroupBox Header="Информация о фильме" Grid.Column="1" Margin="4">
 <StackPanel Margin="4">
 <TextBlock Text="Название" />
 <TextBox Text="{Binding NewTitle, Mode=TwoWay}" />
 <TextBlock Text="Жанр" />
 <TextBox Text="{Binding NewGenre, Mode=TwoWay}" />
 <TextBlock Text="Режиссер" />
 <TextBox Text="{Binding NewDirectorName, Mode=TwoWay}" />
 <TextBlock Text="Год" />
 <TextBox Text="{Binding NewYear, Mode=TwoWay}" />
 <TextBlock Text="Рейтинг" />
 <TextBox Text="{Binding NewRating, Mode=TwoWay}" />
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
 <Button Content="Добавить" Command="{Binding AddMovieCommand}" Margin="0,0,8,0" />
 <Button Content="Удалить" Command="{Binding RemoveMovieCommand}" CommandParameter="{Binding SelectedMovie}" />
 </StackPanel>
 </StackPanel>
 </GroupBox>

 <!--3: Search and sort -->
 <GroupBox Header="Поиск и сортировка" Grid.Column="2" Margin="4">
 <StackPanel Margin="4">
 <TextBlock Text="Жанр" />
 <ComboBox ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" />
 <TextBlock Text="Год от" />
 <TextBox Text="{Binding YearFrom, Mode=TwoWay}" />
 <TextBlock Text="Год до" />
 <TextBox Text="{Binding YearTo, Mode=TwoWay}" />
 <StackPanel Orientation="Horizontal">
 <Button Content="Поиск" Command="{Binding SearchCommand}" Margin="0,4,4,0" />
 <Button Content="Сброс" Command="{Binding ResetFilterCommand}" Margin="0,4,4,0" />
 </StackPanel>
 <TextBlock Text="Сортировка по рейтингу:" Margin="0,8,0,0"/>
 <StackPanel Orientation="Horizontal">
 <Button Content="По возрастанию" Command="{Binding SortAscCommand}" Margin="0,4,4,0" />
 <Button Content="По убыванию" Command="{Binding SortDescCommand}" Margin="0,4,4,0" />
 </StackPanel>
 </StackPanel>
 </GroupBox>

 <!--4: Directors list -->
 <GroupBox Header="Список режиссеров" Grid.Column="3" Margin="4">
 <DockPanel>
 <DataGrid ItemsSource="{Binding Directors}" AutoGenerateColumns="False" DockPanel.Dock="Top" Height="420" IsReadOnly="True">
 <DataGrid.Columns>
 <DataGridTextColumn Header="ФИО" Binding="{Binding Name}" />
 <DataGridTextColumn Header="Кол-во фильмов" Binding="{Binding MoviesCount}" />
 <DataGridTextColumn Header="Средний рейтинг" Binding="{Binding AverageRating}" />
 <DataGridTextColumn Header="Год первого фильма" Binding="{Binding FirstYear}" />
 </DataGrid.Columns>
 </DataGrid>
 <Button Content="Сформировать список" Command="{Binding BuildDirectorsListCommand}" Margin="4" HorizontalAlignment="Right" DockPanel.Dock="Bottom" />
 </DockPanel>
 </GroupBox>

 </Grid>
</Window>